{
  "name": "instacloud-benchmark",
  "scripts": {
    "start": "bun run src/index.ts",
    "deploy": "bun run scripts/deploy.ts",
    "warmup": "bun run scripts/warmup.ts",
    "test": "bun run scripts/test-endpoints.ts",
    "test:endpoints": "bun run scripts/test-endpoints.ts",
    "benchmark": "bun run scripts/run-benchmark.ts",
    "benchmark:compare": "bun run scripts/compare-benchmark.ts",
    "typecheck": "bun check",
    "lint": "oxlint src scripts loadgen",
    "lint:fix": "oxlint --fix src scripts loadgen",
    "loadgen": "bun run loadgen/index.ts",
    "db:clean": "bun run scripts/clean-benchmark-data.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "elysia": "1.4.30",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  }
}