{
  "name": "instacloud-benchmark",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:hono": "bun run src/bun-hono/index.ts",
    "start:elysia": "bun run src/bun-elysia/index.ts",
    "start:express": "node src/node-express/index.js",
    "start:fastify": "node src/node-fastify/index.js",
    "deploy:hono": "bun run scripts/deploy.ts bun-hono",
    "deploy:elysia": "bun run scripts/deploy.ts bun-elysia",
    "deploy:express": "bun run scripts/deploy.ts node-express",
    "typecheck": "bun check",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint src scripts loadgen",
    "lint:fix": "oxlint --fix src scripts loadgen",
    "loadgen": "bun run loadgen/index.ts",
    "test:endpoints": "bun run scripts/test-endpoints.ts",
    "test:hono": "bun run scripts/test-endpoints.ts hono",
    "test:elysia": "bun run scripts/test-endpoints.ts elysia",
    "test:express": "bun run scripts/test-endpoints.ts express",
    "warmup": "bun run scripts/warmup.ts",
    "warmup:hono": "bun run scripts/warmup.ts hono",
    "warmup:elysia": "bun run scripts/warmup.ts elysia",
    "warmup:express": "bun run scripts/warmup.ts express",
    "benchmark": "bun run scripts/run-benchmark.ts",
    "benchmark:hono": "bun run scripts/run-benchmark.ts hono",
    "benchmark:elysia": "bun run scripts/run-benchmark.ts elysia",
    "benchmark:express": "bun run scripts/run-benchmark.ts express",
    "benchmark:compare": "bun run scripts/compare-benchmark.ts",
    "seed": "bun run scripts/seed.ts",
    "migrate": "bun run scripts/migrate.ts",
    "db:clean": "bun run scripts/clean-benchmark-data.ts"
  },
  "dependencies": {
    "elysia": "1.4.30",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  }
}