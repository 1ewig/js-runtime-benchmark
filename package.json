{
  "name": "instacloud-benchmark",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:hono": "bun run src/bun-hono/index.ts",
    "start:elysia": "bun run src/bun-elysia/index.ts",
    "start:express": "node src/node-express/index.js",
    "start:fastify": "node src/node-fastify/index.js",
    "deploy:hono": "bun run scripts/deploy.ts bun-hono",
    "deploy:elysia": "bun run scripts/deploy.ts bun-elysia",
    "deploy:express": "bun run scripts/deploy.ts node-express",
    "deploy:fastify": "bun run scripts/deploy.ts node-fastify",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts loadgen",
    "lint:fix": "oxlint --fix src scripts loadgen",
    "loadgen": "bun run loadgen/index.ts",
    "test:endpoints": "bun run scripts/test-endpoints.ts",
    "warmup": "bun run scripts/warmup.ts",
    "benchmark": "bun run scripts/run-benchmark.ts",
    "seed": "bun run scripts/seed.ts",
    "migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  }
}