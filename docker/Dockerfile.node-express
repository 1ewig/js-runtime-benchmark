# Stage 1: Build & Transpile TypeScript into clean ESM
FROM oven/bun:1.4.3-alpine AS builder
WORKDIR /app

COPY package.json bun.lock* tsconfig.json ./
COPY src ./src
RUN bun build src/node-express/index.ts --target=node --packages=external --outfile=dist/index.mjs

# Stage 2: Production dependencies installed on latest Node Alpine
FROM node:current-alpine AS deps
WORKDIR /app

ENV NODE_ENV=production

COPY package.json bun.lock* ./
RUN npm install --omit=dev --ignore-scripts

# Stage 3: Minimal, unprivileged runtime with latest Node.js Alpine
FROM node:current-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV STACK=node-express
ENV PORT=3000

# Copy node_modules from deps stage
COPY --chown=node:node --from=deps /app/node_modules ./node_modules
COPY --chown=node:node package.json ./
# Copy compiled output from builder stage
COPY --chown=node:node --from=builder /app/dist ./dist

USER node

EXPOSE 3000

CMD ["node", "dist/index.mjs"]
