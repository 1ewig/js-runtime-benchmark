# Copy to .env and fill in real values. Never commit .env - it is gitignored.
#
# Regenerate from InstaCloud instead of hand-editing (recommended):
#   bunx insta secrets -o .env
#
# Run a one-off command with these injected, writing nothing to disk:
#   bunx insta run -- <cmd>

# --- Required -------------------------------------------------------------

# Managed Postgres connection string. Reaches compute only via
# `insta secrets bind DATABASE_URL postgres/db --to compute/<service>`.
# Never hardcode it: src/shared/db.ts throws when it is absent.
DATABASE_URL=

# HMAC-SHA256 key for bearer tokens. Must match across every API service and
# the load generator, or token verification fails. There is no fallback.
#   bunx insta secrets set AUTH_SECRET
AUTH_SECRET=

# --- Runtime tuning (optional, defaults shown) ----------------------------
# src/shared/db.ts: Postgres pool ceiling per process. Benchmarks hold it at 25.
DB_POOL_MAX=25

# docker/*.Dockerfile + loadgen/Dockerfile. Must match the deployed --port.
PORT=3000

# Worker processes. Held at 1 so all four stacks stay single-core comparable.
WEB_CONCURRENCY=1

# Stack selector read by src/index.ts to pick an implementation.
STACK=

# cgroup limits, read by the shared telemetry sampler for CPU/RAM accounting.
VCPU_COUNT=1
MICROVM_RAM_MB=1024

# --- Benchmark harness (optional) -----------------------------------------
# Override the per-stack benchmark targets.
API_URL=
LOADGEN_URL=

# Load shape for scripts/run-benchmark.ts and scripts/compare-benchmark.ts.
USERS=1000
DURATION=20
RAMP_UP=5
THINK_TIME=100